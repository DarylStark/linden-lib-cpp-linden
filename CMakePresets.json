{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25
    },
    "configurePresets": [
        {
            "name": "dbg-linden-with-demo",
            "displayName": "dbg-linden-with-demo",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dbg-linden-with-demo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/Debug/conan_toolchain.cmake",
                "LINDEN_BUILD_SFML_DEMO": "ON"
            }
        },
        {
            "name": "dbg-linden-without-demo",
            "displayName": "dbg-linden-without-demo",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dbg-linden-without-demo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/Debug/conan_toolchain.cmake",
                "LINDEN_BUILD_SFML_DEMO": "OFF"
            }
        }
    ]
}