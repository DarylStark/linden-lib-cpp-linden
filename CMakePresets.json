{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25
    },
    "configurePresets": [
        {
            "name": "dbg-sfml-tests",
            "displayName": "dbg-sfml-tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dbg-sfml-tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/Debug/conan_toolchain.cmake"
            }
        },
        {
            "name": "rel-sfml-tests",
            "displayName": "rel-sfml-tests",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rel-sfml-tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.conan/Release/conan_toolchain.cmake"
            }
        }
    ]
}